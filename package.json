{
  "name": "crm-standard",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Cloud CRM (Standard tier) — real-estate CRM for Indian SMB brokerages",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n server,client \"PORT=3111 nodemon server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1"
  },
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}

# Copy to /etc/crm/.env on the droplet. Never commit real values.
NODE_ENV=production
PORT=3000
DB_PATH=/opt/crm/data/crm.db

# Random 64+ char string (openssl rand -hex 32)
SESSION_SECRET=

# Static bearer token for the WhatsApp bot intake endpoint (openssl rand -hex 32)
WHATSAPP_BOT_TOKEN=

# Google Calendar sync — reuses the WhatsApp agent's Apps Script web app
# Same values as in the agent's .env (APPS_SCRIPT_WEBAPP_URL / APPS_SCRIPT_SHARED_SECRET)
APPS_SCRIPT_WEBAPP_URL=
APPS_SCRIPT_SHARED_SECRET=

# Backups (age public key for encryption, DO Spaces in BLR1)
BACKUP_AGE_RECIPIENT=
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
BACKUP_LOG=/var/log/crm-backup.log
